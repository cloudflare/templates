{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "llm-chat-app-template-e2e",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	}
}
