{
	"name": "email-sending-template",
	"description": "Send a fixed transactional email securely with the Cloudflare Email Service binding.",
	"cloudflare": {
		"label": "Email Sending Worker",
		"products": [
			"Workers",
			"Email Sending"
		],
		"categories": [
			"starter"
		],
		"preview_image_url": "https://imagedelivery.net/aQOPkFaRz89mL6wBwASOcA/email-sending-template-preview/public",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/7ee998bb-6d98-43ab-dd7f-3f2d85a89c00/public",
		"publish": true,
		"docs_url": "https://developers.cloudflare.com/email-service/email-sending/",
		"bindings": {
			"FROM_ADDRESS": {
				"description": "The sender address. Its domain must be onboarded to Cloudflare Email Service."
			},
			"TO_ADDRESS": {
				"description": "The fixed recipient address for this starter."
			},
			"SEND_EMAIL_AUTH_TOKEN": {
				"description": "A strong bearer token that protects the send endpoint. Generate one with `openssl rand -hex 32`."
			}
		}
	},
	"dependencies": {
		"hono": "4.11.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.10",
		"@cloudflare/workers-types": "^5.20261023.1",
		"typescript": "5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5",
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"private": true,
	"resolutions": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"scripts": {
		"cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
		"check": "tsc --noEmit && wrangler deploy --dry-run && vp check",
		"check:toolchain": "vp check",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"e2e:dev": "wrangler dev --config wrangler.e2e.jsonc",
		"format": "vp fmt",
		"test": "vp test run"
	},
	"type": "module"
}
