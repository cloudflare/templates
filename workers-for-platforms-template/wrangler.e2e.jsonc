{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workers-for-platforms-template-e2e",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "workers-for-platforms-template-e2e",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"vars": {
		"DISPATCH_NAMESPACE_NAME": "e2e",
		"CUSTOM_DOMAIN": ""
	}
}
