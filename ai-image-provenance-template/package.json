{
	"name": "ai-image-provenance-template",
	"description": "Detect AI-generated images and verify C2PA content credentials and capture metadata, processed asynchronously with Queues.",
	"cloudflare": {
		"label": "AI Image Provenance Checker",
		"products": [
			"Workers AI",
			"Queues",
			"Containers"
		],
		"categories": [
			"ai"
		]
	},
	"dependencies": {
		"@cloudflare/containers": "0.0.30",
		"hono": "4.11.1",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.21.3",
		"@types/node": "24.10.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.127.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc && tsc -p test/tsconfig.json && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler d1 migrations apply JOBS --local && wrangler dev",
		"predeploy": "wrangler d1 migrations apply JOBS --remote",
		"test": "vitest run"
	},
	"type": "module"
}
