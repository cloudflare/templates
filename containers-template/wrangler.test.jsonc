{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "containers-template-test",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	// Unit tests replace only the container and namespace boundaries.
	// Keep Docker out of these tests; exercise the real image with wrangler dev.
	"durable_objects": {
		"bindings": [{ "name": "MY_CONTAINER", "class_name": "MyContainer" }]
	},
	"exports": {
		"MyContainer": { "type": "durable-object", "storage": "sqlite" }
	}
}
