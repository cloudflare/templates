{
	"name": "email-routing-template",
	"description": "Route incoming email to a verified destination with an Email Routing Worker.",
	"cloudflare": {
		"label": "Email Routing Worker",
		"products": [
			"Workers",
			"Email Routing"
		],
		"categories": [
			"starter"
		],
		"preview_image_url": "https://imagedelivery.net/aQOPkFaRz89mL6wBwASOcA/email-routing-template-preview/public",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/7ee998bb-6d98-43ab-dd7f-3f2d85a89c00/public",
		"publish": true,
		"docs_url": "https://developers.cloudflare.com/email-service/email-routing/",
		"bindings": {
			"ROUTE_ADDRESS": {
				"description": "The Email Routing address shown on the setup page. Keep it in sync with the top-level addresses configuration."
			},
			"FORWARD_TO": {
				"description": "A verified Email Routing destination address that receives forwarded messages."
			},
			"ALLOWED_SENDERS": {
				"description": "A comma-separated list of sender addresses allowed to use this route."
			}
		}
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.10",
		"@cloudflare/workers-types": "^5.20261023.1",
		"typescript": "5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5",
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"private": true,
	"resolutions": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	},
	"scripts": {
		"cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
		"check": "tsc --noEmit && wrangler deploy --dry-run && vp check",
		"check:toolchain": "vp check",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "vp fmt",
		"test": "vp test run"
	},
	"type": "module"
}
