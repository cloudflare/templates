{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": [
			"@cloudflare/workers-types/experimental",
			"./worker-configuration.d.ts"
		]
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts"],
	"exclude": ["test", "vitest.config.ts"]
}
