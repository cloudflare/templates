{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"types": [
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-pool-workers/types"
		],
		"lib": ["ES2022", "WebWorker"],
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["./index.ts", "./src/**/*", "./test/**/*", "./vitest.config.ts"]
}
