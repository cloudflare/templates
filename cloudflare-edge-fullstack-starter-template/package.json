{
	"name": "cloudflare-edge-fullstack-starter-template",
	"description": "A full-stack app on Cloudflare's edge — user accounts, a database, and file uploads — wired the cheap way (KV sessions, D1, R2).",
	"cloudflare": {
		"label": "Edge Full-Stack Starter",
		"products": [
			"Workers",
			"D1",
			"R2"
		],
		"categories": [
			"starter"
		],
		"docs_url": "https://github.com/flarelink-dev/cloudflare-edge-fullstack-starter#readme",
		"bindings": {
			"DB": {
				"description": "D1 database holding your app data (notes) and the auth tables (user / account / verification)."
			},
			"SESSIONS": {
				"description": "KV namespace for session storage — keeps auth checks off D1."
			},
			"BUCKET": {
				"description": "R2 bucket for uploaded files."
			}
		}
	},
	"private": true,
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "npm run build && vite preview",
		"start": "vite",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"typecheck": "tsc --noEmit",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"better-auth": "1.6.11",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.21",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^4.20250101.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"wrangler": "^4.0.0"
	}
}
