{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentskit-agent-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
