{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"@cloudflare/workers-types",
			"@cloudflare/vitest-pool-workers/types"
		]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
