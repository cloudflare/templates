{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nlweb-template-e2e",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"vars": {
		"RAG_ID": "e2e-rag"
	}
}
