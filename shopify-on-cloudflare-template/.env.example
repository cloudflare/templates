# Frontend (Vite): variables prefixed with VITE_ are exposed to the browser
VITE_SHOPIFY_CLIENT_ID=
VITE_BUGSNAG_API_KEY=
VITE_APP_ENV=development

# Backend secrets are NOT loaded from .env in production,
# set them with `npx wrangler secret put NAME` instead. The names below are
# documented here so a developer knows what to provision:
#
#   SHOPIFY_CLIENT_ID     # public client ID from the Shopify Partner dashboard
#   SHOPIFY_API_SECRET    # secret used to verify session tokens (JWT)
#   HOST                  # the bare hostname of your deployed Worker (no protocol, no trailing slash)
#                         # e.g. shopify-on-cloudflare.yourname.workers.dev
