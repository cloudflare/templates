{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"worker-configuration.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"web/**/*.ts",
		"web/**/*.tsx",
		"vite.config.mts"
	],
	"exclude": ["node_modules"]
}
